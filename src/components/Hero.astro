---
// Hero Component - Portada de la home: el titular, el retrato recortado de Karolay sobre
// un bloque rosa y el curso en un panel blanco. Su tarjeta de presentación ya no va aquí:
// junto al retrato distraía del curso (revisión de Karolay); está en «Formación y trayectoria».
import PriceOffer from './PriceOffer.astro';
import { duration } from '../lib/platform/format';
import { presale, type FeaturedCourse } from '../lib/platform/featured';

interface Props {
    featured: FeaturedCourse;
}

const { course, live } = Astro.props.featured;
const offer = presale(course);
const coursePath = `/cursos/${course.slug}`;

// Logos recortados al ras de su dibujo (los originales traen márgenes distintos, que
// descuadran el espaciado). Cada uno lleva su alto para que todos pesen parecido.
const allies = [
    { src: '/marcas/recortes/festival-de-cine-de-ancash.webp', alt: 'Festival de Cine de Áncash', width: 342, height: 176, show: '2.25rem' },
    { src: '/marcas/recortes/vmf-pro.webp', alt: 'VMF Pro', width: 398, height: 128, show: '1.5rem' },
    { src: '/marcas/recortes/veltrac.webp', alt: 'Veltrac', width: 406, height: 96, show: '1.25rem' },
    { src: '/marcas/recortes/antimateria-creative.webp', alt: 'Antimateria+ Creative', width: 249, height: 240, show: '2.25rem' },
];
---

<section class="hero on-dark" id="inicio">
    <div class="hero-inner">
        <div class="hero-copy">
            <h1 class="hero-title font-display font-extrabold uppercase">
                Transforma tus ideas en proyectos
            </h1>
            <p class="hero-lead">
                Te acompaño a convertir tus iniciativas en oportunidades.
            </p>
            <a class="hero-action group" href={coursePath}>
                Conoce el curso
                <span class="material-symbols-outlined transition-transform duration-300 ease-out group-hover:translate-x-1" aria-hidden="true">arrow_forward</span>
            </a>
        </div>

        <div class="hero-stage">
            <div class="hero-block" aria-hidden="true"></div>
            <div class="hero-stripe hero-stripe-a" aria-hidden="true"></div>
            <div class="hero-stripe hero-stripe-b" aria-hidden="true"></div>
            <img class="hero-figure" src="/fotos-karolay/karolay-portada.webp" alt="Karolay Ramírez" width="999" height="895" fetchpriority="high" />
        </div>

    </div>

    <!-- El curso, a la vista desde el primer pantallazo -->
    <div class="hero-panel">
        <div class="hero-panel-inner">
            <a class="group block" href={coursePath}>
                <span class="block font-display text-2xl font-bold leading-tight text-slate-900 transition-colors group-hover:text-[var(--primary)]">{course.title}</span>
                <span class="mt-2 block text-sm text-slate-600">
                    Curso en video{live && ` · ${course.lesson_count} lecciones · ${duration(course.total_duration_seconds)}`}
                </span>
                {live && (
                    <span class="mt-5 block">
                        <PriceOffer product={course} tone="light" size="md" note={offer.active ? `Precio de preventa${offer.untilLabel ? ` hasta el ${offer.untilLabel}` : ''}` : undefined} />
                    </span>
                )}
                <span class="mt-5 inline-flex items-center gap-2 font-bold text-[var(--primary)]">
                    Quiero el curso
                    <span class="material-symbols-outlined transition-transform duration-300 ease-out group-hover:translate-x-1" aria-hidden="true">arrow_right_alt</span>
                </span>
            </a>
            <ul class="hero-allies" aria-label="Confían en mí">
                {allies.map((logo) => (
                    <li><img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} loading="lazy" style={`height: ${logo.show}`} /></li>
                ))}
            </ul>
        </div>
    </div>
</section>

<style>
    .hero {
        --hero-pink: #f0abfc;
        position: relative;
        overflow: hidden;
        background: var(--violet-deep);
        color: #fff;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 80rem;
        margin: 0 auto;
        padding: 3rem 1.5rem 0;
    }

    .hero-title {
        font-size: clamp(2.75rem, 12.5vw, 4.5rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
    }

    .hero-lead {
        margin-top: 1.5rem;
        max-width: 26rem;
        font-size: 1.125rem;
        line-height: 1.6;
        color: #ddd6fe;
    }

    .hero-action {
        margin-top: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem 1rem 2rem;
        border-radius: 9999px;
        background: var(--secondary);
        color: #2e1065;
        font-weight: 700;
        transition: background-color 0.2s ease-out;
    }

    .hero-action:hover {
        background: #fde047;
    }

    /* Karolay sobre el bloque rosa: la figura sale por arriba del bloque */
    .hero-stage {
        position: relative;
        height: 19rem;
        margin-top: 1rem;
    }

    .hero-block {
        position: absolute;
        inset: auto 0 0 0;
        height: 10rem;
        background: var(--hero-pink);
    }

    .hero-stripe {
        display: none;
        position: absolute;
        bottom: 0;
        width: 1.5rem;
        background: var(--hero-pink);
        opacity: 0.6;
    }

    .hero-figure {
        position: absolute;
        bottom: 0;
        left: 50%;
        height: 100%;
        width: auto;
        max-width: none;
        transform: translateX(-50%);
    }

    .hero-panel {
        position: relative;
        z-index: 1;
        background: #fff;
    }

    .hero-panel-inner {
        max-width: 80rem;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    /* Los logos se reparten de borde a borde, con el mismo espacio entre uno y otro */
    .hero-allies {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #cbd5e1;
    }

    .hero-allies li {
        display: flex;
        align-items: center;
        min-width: 0;
        height: 2.25rem;
    }

    .hero-allies img {
        width: auto;
        max-width: 100%;
        object-fit: contain;
        filter: grayscale(100%);
        mix-blend-mode: multiply;
    }

    @media (min-width: 640px) {
        .hero-inner {
            padding-top: 4rem;
        }

        .hero-stage {
            height: 26rem;
        }

        .hero-block {
            height: 14rem;
        }
    }

    /* Escritorio: todo en un solo pantallazo, con el panel blanco pegado arriba a la derecha.
       El alto alcanza justo para el panel sobre el bloque rosa, que asienta en el borde de
       abajo como en el celular; el texto se centra en ese alto, sin vacío debajo. */
    @media (min-width: 1024px) {
        .hero {
            --hero-height: 39rem;
            --block-height: 12rem;
            --block-bottom: 0rem;
            min-height: var(--hero-height);
        }

        /* El contenedor queda encima del panel blanco: solo sus piezas reciben el clic */
        .hero-inner {
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: var(--hero-height);
            padding: 3rem 2rem;
            pointer-events: none;
        }

        .hero-copy {
            max-width: 28rem;
            pointer-events: auto;
        }

        .hero-title {
            font-size: 4.25rem;
        }

        .hero-lead {
            max-width: 19rem;
            font-size: 1rem;
        }

        .hero-action {
            align-self: flex-start;
        }

        .hero-stage {
            position: absolute;
            z-index: -1;
            left: 24rem;
            right: 2rem;
            bottom: var(--block-bottom);
            height: 22rem;
            margin: 0;
        }

        .hero-block {
            right: 5rem;
            height: var(--block-height);
        }

        .hero-stripe {
            display: block;
            height: var(--block-height);
        }

        .hero-stripe-a {
            right: 2.5rem;
        }

        .hero-stripe-b {
            right: 0;
        }

        /* El retrato es ancho (brazos en jarra): se corre a la izquierda para no tapar el panel */
        .hero-figure {
            left: -0.5rem;
            transform: none;
        }

        .hero-panel {
            position: absolute;
            z-index: 0;
            top: 0;
            right: 0;
            left: calc(50% + 9rem);
            height: calc(var(--hero-height) - var(--block-bottom) - var(--block-height));
        }

        .hero-panel-inner {
            display: flex;
            flex-direction: column;
            height: 100%;
            max-width: 27rem;
            margin: 0;
            padding: 2.5rem 2rem 2rem 2.5rem;
        }

        .hero-allies {
            margin-top: auto;
        }
    }

    @media (min-width: 1280px) {
        .hero {
            --hero-height: 43rem;
            --block-height: 16rem;
        }

        .hero-copy {
            max-width: 35rem;
        }

        .hero-title {
            font-size: 5rem;
        }

        .hero-lead {
            max-width: 23rem;
            font-size: 1.125rem;
        }

        .hero-stage {
            left: 30rem;
            height: 30rem;
        }

        .hero-block {
            right: 6rem;
        }

        .hero-stripe-a {
            right: 3rem;
        }

        .hero-figure {
            left: -1rem;
        }

        .hero-panel {
            left: calc(50% + 13rem);
        }

        .hero-panel-inner {
            padding-left: 3rem;
        }
    }
</style>
