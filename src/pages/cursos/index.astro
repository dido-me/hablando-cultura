---
// Catálogo de cursos (renderizado en el servidor para que Google lo indexe).
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { getCatalog } from '../../lib/platform/server';
import { duration, soles } from '../../lib/platform/format';
import type { Course } from '../../lib/platform/types';

let courses: Course[] = [];
let failed = false;
try {
	courses = await getCatalog();
} catch {
	failed = true;
}
---

<PlatformLayout title="Cursos" description="Cursos de gestión cultural y emprendimiento artístico con Karolay Ramírez.">
	<section class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
		<h1 class="font-display text-5xl font-bold text-slate-900">Cursos</h1>
		<p class="mt-3 max-w-2xl text-lg text-slate-600">Aprende a convertir tus ideas culturales en proyectos reales, a tu ritmo y desde donde estés.</p>

		{failed && <p class="mt-10 rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-800">No pudimos cargar los cursos. Intenta de nuevo en unos minutos.</p>}
		{!failed && courses.length === 0 && <p class="mt-10 text-slate-500">Pronto publicaremos nuevos cursos.</p>}

		<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
			{courses.map((course) => (
				<a href={`/cursos/${course.slug}`} class="group relative block overflow-hidden rounded-3xl bg-white shadow-sm transition-all duration-500 hover:shadow-2xl">
					{course.current_price_cents < course.price_cents && (
						<span class="absolute top-4 left-4 z-10 rounded-full bg-[var(--secondary)] px-3 py-1 text-xs font-bold">Preventa</span>
					)}
					<div class="aspect-video overflow-hidden bg-[var(--lavender)]">
						{course.cover_url && <img alt="" src={course.cover_url} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" />}
					</div>
					<div class="p-8">
						<h2 class="font-display text-xl font-bold text-slate-900">{course.title}</h2>
						{course.subtitle && <p class="mt-2 line-clamp-2 text-sm text-slate-500">{course.subtitle}</p>}
						<div class="mt-6 flex items-center justify-between">
							<span class="text-sm text-slate-500">{course.lesson_count} lecciones · {duration(course.total_duration_seconds)}</span>
							<span class="font-display text-lg font-extrabold text-[var(--primary)]">{soles(course.current_price_cents)}</span>
						</div>
					</div>
				</a>
			))}
		</div>
	</section>
</PlatformLayout>
