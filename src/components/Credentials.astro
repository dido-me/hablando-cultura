---
// Credentials Component - Formación y trayectoria de Karolay
const credentials = [
    { title: 'Comunicadora Audiovisual', place: 'PUCP, Perú' },
    { title: 'Magíster en Teatro y Artes Escénicas', place: 'UCM, Madrid' },
    { title: 'Máster en Distribución y Negocio en la Industria Audiovisual', place: 'ECAM' },
    { title: 'Diplomado en Gestión Cultural', place: 'UARM' },
    { title: 'Fundadora y directora', place: 'Festival de Cine de Áncash' },
    { title: 'Creadora del podcast', place: 'Hablando Cultura' },
];
---

<section class="bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14 lg:py-20 grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
            <!-- La presentación de Karolay va aquí y no en la portada, para que junto a su
                 retrato quede solo el curso. -->
            <a class="group mb-10 flex items-center gap-4" href="#proyectos">
                <img src="/fotos-karolay/1.webp" alt="" width="80" height="80" loading="lazy" class="h-20 w-20 flex-none object-cover" />
                <span class="min-w-0">
                    <span class="block font-display text-lg font-semibold text-slate-900">Karolay Ramírez</span>
                    <span class="mt-1 block text-sm text-slate-600">Comunicadora audiovisual, gestora cultural y docente</span>
                    <span class="mt-2 inline-flex items-center gap-2 font-semibold text-[var(--primary)]">
                        Conoce mis proyectos
                        <span class="material-symbols-outlined transition-transform duration-300 ease-out group-hover:translate-x-1" aria-hidden="true">arrow_right_alt</span>
                    </span>
                </span>
            </a>
            <h2 class="font-display text-3xl font-bold text-slate-900">Formación y trayectoria</h2>
            <p class="mt-4 text-lg text-slate-600 leading-relaxed">
                Más de 10 años de experiencia, más de 10 premios nacionales, más de 10 proyectos ejecutados y la 3.ª edición del curso en 2026.
            </p>
        </div>
        <ul class="lg:col-span-8 grid sm:grid-cols-2 sm:gap-x-12">
            {credentials.map((item) => (
                <li class="border-t border-slate-200 py-5">
                    <p class="font-semibold text-slate-900">{item.title}</p>
                    {item.place && <p class="mt-1 text-slate-600">{item.place}</p>}
                </li>
            ))}
        </ul>
    </div>
</section>
