---
// Página de venta del ebook. El precio y el producto vienen de la API (como los cursos);
// la compra y la descarga las maneja la isla CourseActions.
import PlatformLayout from '../layouts/PlatformLayout.astro';
import CourseActions from '../components/platform/CourseActions';
import { getCourse } from '../lib/platform/server';

const EBOOK_SLUG = '10-pasos-para-tu-proyecto-cultural';

let page = null;
try {
	page = await getCourse(EBOOK_SLUG);
} catch {
	page = null;
}
const ebook = page?.course;
// Las tres páginas de muestra son fijas: portada, contenido y autora.
const pages = [
	{ src: '/ebook/1.png', label: 'Portada', alt: 'Portada del ebook 10 Pasos para tu Proyecto Cultural' },
	{ src: '/ebook/2.png', label: 'Contenido: los 10 pasos', alt: 'Página de contenido del ebook, con los 10 pasos' },
	{ src: '/ebook/3.png', label: 'Sobre la autora', alt: 'Página del ebook sobre la autora, Karolay Ramírez' },
];
---

<PlatformLayout title={ebook?.title ?? '10 Pasos para tu Proyecto Cultural'} description={ebook?.subtitle ?? 'Ebook de Karolay Ramírez.'}>
	<section class="bg-[var(--lavender)]">
		<div class="max-w-7xl mx-auto px-6 lg:px-8 py-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start">
			<div class="grid gap-10 md:grid-cols-[16rem_minmax(0,1fr)] md:items-start">
				<img alt="Portada del ebook 10 Pasos para tu Proyecto Cultural" src="/ebook/1.png" class="mx-auto w-full max-w-60 rounded-2xl shadow-2xl md:mx-0 md:max-w-xs" />
				<div>
					<span class="inline-block rounded-full bg-[var(--secondary)] px-3 py-1 text-xs font-bold">Ebook · Precio especial</span>
					<h1 class="mt-4 font-display text-4xl font-bold text-slate-900 md:text-5xl">{ebook?.title ?? '10 Pasos para tu Proyecto Cultural'}</h1>
					{ebook?.subtitle && <p class="mt-4 text-lg text-slate-600">{ebook.subtitle}</p>}
					{ebook?.description && <p class="mt-4 text-slate-600">{ebook.description}</p>}
					{ebook?.objectives && (
						<ul class="mt-6 space-y-3">
							{ebook.objectives.map((item) => (
								<li class="flex items-center gap-3 text-slate-700">
									<span class="material-symbols-outlined text-[var(--primary)]">check_circle</span>
									{item}
								</li>
							))}
						</ul>
					)}
				</div>
			</div>
			<div class="lg:sticky lg:top-28">
				{ebook ? (
					<CourseActions client:load course={ebook} pagePath="/ebook" />
				) : (
					<p class="rounded-3xl bg-white p-6 text-sm text-slate-600 ring-1 ring-slate-100">El ebook no está disponible en este momento. Escríbenos y te ayudamos.</p>
				)}
			</div>
		</div>
	</section>

	<section class="bg-white">
		<div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-24 grid gap-10 lg:grid-cols-[minmax(0,17rem)_minmax(0,1fr)] lg:gap-12 xl:gap-16">
			<div>
				<h2 class="font-display text-3xl font-bold text-slate-900">Vista previa</h2>
				<p class="mt-4 max-w-md text-lg leading-relaxed text-slate-600">
					Tres páginas del ebook: la portada, el contenido con los 10 pasos y la presentación de la autora.
				</p>
				<p class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--primary)]">
					<span class="material-symbols-outlined" aria-hidden="true">zoom_in</span>
					Toca una página para ampliarla
				</p>
			</div>
			<!-- En el móvil las páginas se deslizan de lado; desde 640 px van las tres en fila -->
			<ul class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pt-2 pb-8 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-5 sm:overflow-visible sm:p-0 xl:gap-7">
				{pages.map((page) => (
					<li class="w-[64%] flex-none snap-center sm:w-auto">
						<a
							href={page.src}
							class="glightbox block cursor-zoom-in overflow-hidden rounded-xl ring-1 ring-slate-200 shadow-[0_18px_40px_-18px_rgba(46,16,101,0.45)] transition duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_28px_50px_-20px_rgba(46,16,101,0.55)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--primary)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
							data-gallery="ebook-preview"
							data-description={page.label}
							aria-label={`Ampliar página: ${page.label}`}
						>
							<img alt={page.alt} src={page.src} width="512" height="800" loading="lazy" class="h-auto w-full" />
						</a>
						<p class="mt-4 text-sm font-medium text-slate-700">{page.label}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<script>
		import GLightbox from 'glightbox';
		import 'glightbox/dist/css/glightbox.min.css';

		GLightbox({ selector: '.glightbox', touchNavigation: true, loop: true, zoomable: true, draggable: true });
	</script>
</PlatformLayout>
