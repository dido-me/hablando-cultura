---
// Contacto y enlaces legales del pie de página, en el sitio y en la plataforma de cursos.
// Culqi pide teléfono, correo y dirección visibles, y el Libro de Reclamaciones a la vista.
import { BUSINESS } from '../lib/platform/config';

const phoneDigits = BUSINESS.phone.replace(/\D/g, '');
---

<div class="text-sm text-slate-400 space-y-6">
	<div class="flex flex-col items-center gap-x-8 gap-y-2 sm:flex-row sm:justify-center">
		<a class="inline-flex items-center gap-2 hover:text-white" href={`mailto:${BUSINESS.email}`}>
			<span class="material-symbols-outlined text-lg">mail</span>{BUSINESS.email}
		</a>
		{BUSINESS.phone && (
			<a class="inline-flex items-center gap-2 hover:text-white" href={`https://wa.me/${phoneDigits.startsWith('51') ? phoneDigits : `51${phoneDigits}`}`} target="_blank" rel="noopener noreferrer">
				<span class="material-symbols-outlined text-lg">call</span>{BUSINESS.phone}
			</a>
		)}
		{BUSINESS.address && (
			<span class="inline-flex items-center gap-2">
				<span class="material-symbols-outlined text-lg">location_on</span>{BUSINESS.address}
			</span>
		)}
	</div>
	<nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2" aria-label="Información legal">
		<a class="hover:text-white" href="/terminos">Términos y condiciones</a>
		<a class="hover:text-white" href="/devoluciones">Cambios y devoluciones</a>
		<a class="hover:text-white" href="/privacidad">Política de privacidad</a>
		<a class="inline-flex items-center gap-2 rounded-xl border border-slate-600 px-3 py-2 font-semibold text-slate-200 hover:border-white hover:text-white" href="/libro-de-reclamaciones">
			<span class="material-symbols-outlined text-lg">menu_book</span>Libro de Reclamaciones
		</a>
	</nav>
	<p class="text-xs text-slate-500">{BUSINESS.tradeName} · {BUSINESS.name} · RUC {BUSINESS.ruc}</p>
</div>
