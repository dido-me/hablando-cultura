---
// Services Component - Servicios Especializados
const services = [
    { name: 'Gestión', text: 'Planificación integral y administración de recursos para el éxito de tu iniciativa.' },
    { name: 'Asesorías', text: 'Mentoría personalizada uno a uno para desbloquear el potencial de tu proyecto.' },
    { name: 'Docencia', text: 'Programas académicos de alto nivel orientados a la gestión cultural práctica.' },
    { name: 'Charlas vocacionales', text: 'Inspirando a las nuevas generaciones a ver el arte como un camino profesional viable.', isNew: true },
    {
        name: 'Producción cultural',
        text: 'Ejecución técnica integral para dar vida a tus proyectos artísticos.',
        areas: ['Eventos', 'Cine', 'Teatro', 'Ferias', 'Festivales'],
    },
    { name: 'Marketing cultural', text: 'Estrategias de comunicación para conectar tu obra con la audiencia ideal.' },
];
---

<section class="py-16 lg:py-24 bg-white" id="servicios">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4 lg:sticky lg:top-28 lg:self-start">
            <h2 class="font-display text-4xl font-bold text-slate-900">Servicios especializados</h2>
            <p class="mt-4 text-lg text-slate-600">Soluciones a medida para cada etapa de tu camino cultural.</p>
            <a class="mt-6 inline-flex items-center gap-2 font-bold text-[var(--primary)] underline-offset-4 hover:underline" href="#contacto">
                Conversemos sobre tu proyecto <span class="material-symbols-outlined" aria-hidden="true">arrow_right_alt</span>
            </a>
        </div>
        <dl class="lg:col-span-8 border-b border-slate-200">
            {services.map((service) => (
                <div class="grid gap-2 border-t border-slate-200 py-6 sm:grid-cols-[18rem_1fr] sm:gap-8">
                    <dt class="font-display text-xl font-bold text-slate-900">
                        {service.name}
                        {service.isNew && <span class="ml-2 inline-block rounded-full bg-[var(--secondary)] px-2.5 py-0.5 align-middle font-sans text-xs font-bold">Nuevo</span>}
                    </dt>
                    <dd class="text-slate-600 leading-relaxed">
                        {service.text}
                        {service.areas && <span class="mt-2 block text-sm font-semibold text-violet-700">{service.areas.join(' · ')}</span>}
                    </dd>
                </div>
            ))}
        </dl>
    </div>
</section>
