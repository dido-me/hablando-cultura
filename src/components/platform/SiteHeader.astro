---
// Header de la plataforma de cursos: enlaces a las secciones del sitio, el menú de cuenta y,
// en el celular, el menú hamburguesa.
import AccountMenu from './AccountMenu';
import MobileMenu from '../MobileMenu.astro';

const path = Astro.url.pathname;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/cursos', label: 'Cursos' },
  { href: '/ebook', label: 'E-book' },
  { href: '/blog', label: 'Blog' },
].map((link) => ({ ...link, active: active(link.href) }));
---

<header class="sticky-header">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex h-20 items-center justify-between gap-4">
            <a class="font-display font-extrabold text-xl tracking-tighter text-slate-900" href="/">KAROLAY RAMÍREZ</a>
            <nav class="hidden md:flex items-center space-x-8" aria-label="Principal">
                {links.map((link) => (
                    <a
                        href={link.href}
                        aria-current={link.active ? 'page' : undefined}
                        class:list={[
                            'text-sm font-semibold transition-colors hover:text-[var(--primary)]',
                            link.active ? 'text-[var(--primary)]' : 'text-slate-600',
                        ]}
                    >
                        {link.label}
                    </a>
                ))}
            </nav>
            <div class="flex items-center gap-2">
                <AccountMenu client:load />
                <MobileMenu links={links} />
            </div>
        </div>
    </div>
</header>
