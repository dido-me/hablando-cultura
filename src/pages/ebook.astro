---
// Página de venta del ebook. El precio y el producto vienen de la API (como los cursos);
// la compra y la descarga las maneja la isla CourseActions.
import PlatformLayout from '../layouts/PlatformLayout.astro';
import CourseActions from '../components/platform/CourseActions';
import { getCourse } from '../lib/platform/server';

const EBOOK_SLUG = '10-pasos-para-tu-proyecto-cultural';

let page = null;
try {
	page = await getCourse(EBOOK_SLUG);
} catch {
	page = null;
}
const ebook = page?.course;
const pages = ['/ebook/1.png', '/ebook/2.png', '/ebook/3.png'];
---

<PlatformLayout title={ebook?.title ?? '10 Pasos para tu Proyecto Cultural'} description={ebook?.subtitle ?? 'Ebook de Karolay Ramírez.'}>
	<section class="bg-[var(--lavender)]">
		<div class="max-w-7xl mx-auto px-6 lg:px-8 py-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start">
			<div class="grid gap-10 md:grid-cols-[16rem_minmax(0,1fr)] md:items-start">
				<img alt="Portada del ebook 10 Pasos para tu Proyecto Cultural" src="/ebook/1.png" class="mx-auto w-full max-w-60 rounded-2xl shadow-2xl md:mx-0 md:max-w-xs" />
				<div>
					<span class="inline-block rounded-full bg-[var(--secondary)] px-3 py-1 text-xs font-bold">Ebook · Precio especial</span>
					<h1 class="mt-4 font-display text-4xl font-bold text-slate-900 md:text-5xl">{ebook?.title ?? '10 Pasos para tu Proyecto Cultural'}</h1>
					{ebook?.subtitle && <p class="mt-4 text-lg text-slate-600">{ebook.subtitle}</p>}
					{ebook?.description && <p class="mt-4 text-slate-600">{ebook.description}</p>}
					{ebook?.objectives && (
						<ul class="mt-6 space-y-3">
							{ebook.objectives.map((item) => (
								<li class="flex items-center gap-3 text-slate-700">
									<span class="material-symbols-outlined text-[var(--primary)]">check_circle</span>
									{item}
								</li>
							))}
						</ul>
					)}
				</div>
			</div>
			<div class="lg:sticky lg:top-28">
				{ebook ? (
					<CourseActions client:load course={ebook} pagePath="/ebook" />
				) : (
					<p class="rounded-3xl bg-white p-6 text-sm text-slate-600 ring-1 ring-slate-100">El ebook no está disponible en este momento. Escríbenos y te ayudamos.</p>
				)}
			</div>
		</div>
	</section>

	<section class="max-w-7xl mx-auto px-6 lg:px-8 py-14">
		<h2 class="font-display text-2xl font-bold text-slate-900">Vista previa</h2>
		<div class="mt-6 grid grid-cols-3 gap-4 max-w-2xl">
			{pages.map((src, i) => (
				<a href={src} class="glightbox block overflow-hidden rounded-xl shadow-sm ring-1 ring-slate-100" data-gallery="ebook-preview" data-description={`Página ${i + 1}`}>
					<img alt={`Ebook página ${i + 1}`} src={src} class="w-full transition-transform duration-300 hover:scale-105" />
				</a>
			))}
		</div>
	</section>

	<script>
		import GLightbox from 'glightbox';
		import 'glightbox/dist/css/glightbox.min.css';

		GLightbox({ selector: '.glightbox', touchNavigation: true, loop: true, zoomable: true, draggable: true });
	</script>
</PlatformLayout>
