---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { getFeaturedCourse, getFeaturedEbook } from "../lib/platform/featured";

// Importar todos los componentes de sección
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Credentials from "../components/Credentials.astro";
import CourseFeature from "../components/CourseFeature.astro";
import Projects from "../components/Projects.astro";
import Ebook from "../components/Ebook.astro";
import Services from "../components/Services.astro";
import Clients from "../components/Clients.astro";
import Timeline from "../components/Timeline.astro";
import Blog from "../components/Blog.astro";
import Events from "../components/Events.astro";
import Footer from "../components/Footer.astro";
import PresaleSwitch from "../components/PresaleSwitch.astro";

// El curso y el ebook que la home promociona, leídos de la API al compilar.
const [featured, ebook] = await Promise.all([getFeaturedCourse(), getFeaturedEbook()]);
---

<Layout>
  <div class="home">
    <!-- Header / Navegación -->
    <Header />

    <!-- Hero / Inicio -->
    <Hero featured={featured} />

    <!-- Formación y trayectoria -->
    <Credentials />

    <!-- Curso -->
    <CourseFeature featured={featured} />

    <!-- Servicios -->
    <Services />

    <!-- E-book -->
    <Ebook ebook={ebook} />

    <!-- Proyectos -->
    <Projects />

    <!-- Clientes / Aliados -->
    <Clients />

    <!-- Trayectoria -->
    <Timeline />

    <!-- Blog -->
    <Blog />

    <!-- Eventos -->
    <Events />

    <!-- Footer / Contacto -->
    <Footer />
  </div>

  <PresaleSwitch />
</Layout>
