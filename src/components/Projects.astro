---
// Projects Component - Proyectos Impactantes
const projects = [
    {
        href: '/hablando-cultura',
        title: 'Hablando Cultura',
        text: 'Podcast para quienes viven, crean y emprenden desde el arte y la cultura.',
        image: '/fotos-karolay/3.webp',
        alt: 'Karolay Ramírez entrevista a un invitado en el set del podcast Hablando Cultura',
        action: 'Ver el podcast',
        position: 'object-center',
    },
    {
        href: '/festival-de-cine-de-ancash',
        title: 'Festival de Cine de Áncash',
        text: 'Plataforma de exhibición y fomento de la cinematografía en el Callejón de Huaylas.',
        image: '/blogs/img/533231717_18049803017540207_2819876465897566719_n.jpg',
        alt: 'Festival de Cine de Áncash',
        action: 'Ver el festival',
        // El afiche es vertical: el recorte muestra al personaje y no el texto de las fechas.
        position: 'object-[50%_66%]',
    },
];
---

<section class="py-16 lg:py-24 bg-white" id="proyectos">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="mb-10 lg:mb-14">
            <h2 class="font-display text-4xl font-bold text-slate-900">Proyectos impactantes</h2>
            <p class="mt-4 max-w-xl text-lg text-slate-600">Iniciativas que transforman el panorama cultural en la región.</p>
        </div>
        <div class="grid gap-12 md:grid-cols-2 md:gap-10">
            {projects.map((project) => (
                <a href={project.href} class="group block">
                    <div class="aspect-[3/2] overflow-hidden rounded-3xl bg-[var(--lavender)]">
                        <img alt={project.alt} class:list={["h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105", project.position]} src={project.image} loading="lazy" />
                    </div>
                    <h3 class="mt-6 font-display text-2xl font-bold text-slate-900 transition-colors group-hover:text-[var(--primary)]">{project.title}</h3>
                    <p class="mt-2 max-w-md text-slate-600">{project.text}</p>
                    <span class="mt-4 inline-flex items-center gap-2 font-bold text-[var(--primary)]">
                        {project.action} <span class="material-symbols-outlined transition-transform duration-300 ease-out group-hover:translate-x-1" aria-hidden="true">arrow_right_alt</span>
                    </span>
                </a>
            ))}
        </div>
    </div>
</section>
