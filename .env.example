# Copia este archivo a .env y completa los valores.

# Google Calendar (eventos)
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=

PUBLIC_WHATSAPP_GROUP_URL=

# Plataforma de cursos. Todo lo que empieza con PUBLIC_ llega al navegador: nunca pongas
# aquí llaves secretas (la de Culqi sk_ y la de R2 viven solo en el backend).
# API de cursos (en producción, la URL pública de la API).
PUBLIC_API_URL=http://localhost:4000
# Opcional: URL de la API para el servidor de Astro (catálogo y formularios del newsletter
# y del ebook), si no es la pública. En el VPS: http://localhost:4000.
API_URL=
# CulqiPanel > Desarrollo > API Keys: llave pública pk_test_ (local) o pk_live_ (producción).
PUBLIC_CULQI_PUBLIC_KEY=
# Google Cloud > Credenciales > ID de cliente de OAuth (vacío oculta el botón de Google).
PUBLIC_GOOGLE_CLIENT_ID=
# Aprobación manual (Yape/Plin con captura que Karolay revisa). Apagada: todo se cobra
# con Culqi. true la vuelve a mostrar junto a Culqi.
PUBLIC_MANUAL_PAYMENTS=
# Contacto visible en el pie de página (Culqi lo exige): WhatsApp y, si la hay, dirección.
PUBLIC_CONTACT_PHONE=
PUBLIC_BUSINESS_ADDRESS=
# Número de Yape/Plin para pagos con captura, y a nombre de quién está.
PUBLIC_YAPE_NUMBER=
PUBLIC_YAPE_HOLDER=Karolay Ramírez
